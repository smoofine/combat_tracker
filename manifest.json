{
  "name": "Combat Tracker — D&D 5e",
  "short_name": "Combat Tracker",
  "description": "Gestor de turno de combate para D&D 5e. Compatible con archivos XML de Fight Club 5e.",
  "start_url": "/combat_tracker/",
  "scope": "/combat_tracker/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#12121e",
  "theme_color": "#12121e",
  "lang": "es",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "https://smoofine.github.io/combat_tracker/?from-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "character",
          "accept": [
            "text/xml",
            "application/xml",
            "application/octet-stream",
            "text/plain",
            "*/*",
            ".xml",
            ".dnd5e"
          ]
        }
      ]
    }
  }
}
